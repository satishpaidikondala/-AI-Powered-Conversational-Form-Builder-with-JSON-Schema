# Port for the backend API server
API_PORT=8080

# API Key for the LLM service (e.g., OpenAI, Anthropic, Google)
LLM_API_KEY="your_llm_api_key_here"

# LLM provider: "openai", "anthropic", "gemini", or "mock" (default: mock)
LLM_PROVIDER=mock

# Mock mode forces using the mock LLM even if API keys are provided
# Set to "true" to use mock, "false" to use real LLM
MOCK_LLM=true
